<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform's own Material theme, light here and dark in values-night,
         so the app needs no support library. -->
    <style name="Theme.Squiggly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#D9620F</item>
        <item name="android:colorPrimary">#D9620F</item>
        <item name="android:windowBackground">#FCF9F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Squiggly.Translucent" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">#D9620F</item>
    </style>
</resources>
