<?xml version="1.0" encoding="utf-8"?>
<!-- The keyboard's entry in the system's keyboard list. It offers switching
     back, because it is meant to be switched to for maths and away again. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="io.github.superwalrus01.squiggly.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/keyboard_subtype"
        android:imeSubtypeLocale="en"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
</input-method>
