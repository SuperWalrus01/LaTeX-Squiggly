{
  "manifest_version": 3,
  "name": "LaTeX Squiggly",
  "short_name": "Squiggly",
  "version": "0.3.0",
  "description": "Type LaTeX in any text box and get real symbols (\\alpha becomes α). Select LaTeX and right-click to copy it as an image.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LaTeX Squiggly",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/worker.js"
  },
  "commands": {
    "toggle-conversion": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Pause or resume converting"
    },
    "open-renderer": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open the renderer, to turn LaTeX into an image"
    }
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "engine/tables.js",
        "engine/engine.js",
        "shared/settings.js",
        "content/keyboard.js",
        "content/content.js",
        "content/docs.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
