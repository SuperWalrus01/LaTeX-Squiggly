<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows app. Everything that touches Win32 lives in Platform/; all the
    logic comes from LaTeXSquiggly.Core, which has no platform dependency and is
    checked against the Swift engine by the conformance runner.

    Published self-contained so the user needs no .NET install: one .exe, no
    admin rights, no installer.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LaTeXSquiggly.App</RootNamespace>
    <AssemblyName>LaTeX Squiggly</AssemblyName>
    <Product>LaTeX Squiggly</Product>
    <AssemblyTitle>LaTeX Squiggly</AssemblyTitle>
    <Company>LaTeX Squiggly</Company>
    <!-- One source of truth, shared with the macOS build. app.manifest is the
         only literal left, and scripts/check-version.py fails the build if it
         disagrees with this. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The keyboard hook reads each key event through its pointer instead of
         marshalling a copy, so nothing is allocated per keystroke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LaTeXSquiggly.Core/LaTeXSquiggly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The renderer window's web view. The runtime is part of Windows 11 and
         of Windows 10 as updated since 2021; see RendererWindow for the rest. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- The renderer window's page: the extension's renderer, and the same page
         around it as the Mac app's window, laid out as
         Sources/LaTeXSquigglyApp/Web/files.json lays it out. Embedded, and
         served from memory; RendererWindow looks them up by "web/" + path. -->
    <EmbeddedResource Include="../../Sources/LaTeXSquigglyApp/Web/renderer.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="../../Sources/LaTeXSquigglyApp/Web/window.js" LogicalName="web/window.js" />
    <EmbeddedResource Include="../../Sources/LaTeXSquigglyApp/Web/window.css" LogicalName="web/window.css" />
    <EmbeddedResource Include="../../chrome/shared/ui.css" LogicalName="web/shared/ui.css" />
    <EmbeddedResource Include="../../chrome/engine/tables.js" LogicalName="web/engine/tables.js" />
    <EmbeddedResource Include="../../chrome/renderer/**/*" LogicalName="web/renderer/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by scripts/make-windows-icons.py from assets/menu-icon.png and
         assets/app-icon.png. Named without a folder so the loader can ask for
         them by file name. -->
    <EmbeddedResource Include="Assets/tray-active.ico" LogicalName="tray-active.ico" />
    <EmbeddedResource Include="Assets/tray-inactive.ico" LogicalName="tray-inactive.ico" />
    <EmbeddedResource Include="Assets/app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
