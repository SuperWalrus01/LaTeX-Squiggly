<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows app. Everything that touches Win32 lives in Platform/; all the
    logic comes from LaTeXSquiggly.Core, which has no platform dependency and is
    checked against the Swift engine by the conformance runner.

    Published self-contained so the user needs no .NET install: one .exe, no
    admin rights, no installer.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LaTeXSquiggly.App</RootNamespace>
    <AssemblyName>LaTeX Squiggly</AssemblyName>
    <Product>LaTeX Squiggly</Product>
    <AssemblyTitle>LaTeX Squiggly</AssemblyTitle>
    <Company>LaTeX Squiggly</Company>
    <!-- One source of truth, shared with the macOS build. app.manifest is the
         only literal left, and Tools/check_version.py fails the build if it
         disagrees with this. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LaTeXSquiggly.Core/LaTeXSquiggly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by Tools/make_windows_icons.py from Assets/menu-icon.png and
         Assets/app-icon.png. Named without a folder so the loader can ask for
         them by file name. -->
    <EmbeddedResource Include="Assets/tray-active.ico" LogicalName="tray-active.ico" />
    <EmbeddedResource Include="Assets/tray-inactive.ico" LogicalName="tray-inactive.ico" />
    <EmbeddedResource Include="Assets/app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
