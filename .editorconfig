# Formatting shared by every editor. See CONTRIBUTING.md, "Style".
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,css,html,json,yml,yaml}]
indent_size = 2

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Generated files keep whatever their generator writes.
[{conformance/*.json,chrome/engine/tables.js,site/assets/data.js}]
indent_size = unset
